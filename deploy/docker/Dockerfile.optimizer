# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim

ARG CODEX_CLI_VERSION=0.137.0

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl git unzip \
  && curl --fail --silent --show-error \
    "https://awscli.amazonaws.com/awscli-exe-linux-x86_64.zip" \
    --output /tmp/awscliv2.zip \
  && unzip -q /tmp/awscliv2.zip -d /tmp \
  && /tmp/aws/install \
  && npm install --global "@openai/codex@${CODEX_CLI_VERSION}" \
  && rm -rf /var/lib/apt/lists/* /tmp/aws /tmp/awscliv2.zip

ENV NODE_ENV=development
ENV HOME=/home/node
WORKDIR /workspace

COPY --chown=node:node . .
RUN cd agent && npm ci --cache /tmp/npm-cache \
  && rm -rf /tmp/npm-cache \
  && chown node:node /workspace

USER node
RUN git init -q \
  && git add -A \
  && git -c user.name=mantle-optimizer -c user.email=optimizer@local \
    commit -qm "optimizer image source"

ENTRYPOINT ["bash", "deploy/aws/optimizer/fargate-entrypoint.sh"]
