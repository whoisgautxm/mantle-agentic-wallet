# syntax=docker/dockerfile:1

FROM node:22-bookworm-slim AS deps
WORKDIR /app/agent
COPY agent/package.json agent/package-lock.json ./
RUN npm ci

FROM node:22-bookworm-slim AS builder
WORKDIR /app
COPY --from=deps /app/agent/node_modules ./agent/node_modules
COPY agent ./agent
COPY shared ./shared
WORKDIR /app/agent
RUN npm run build && npm prune --omit=dev

FROM node:22-bookworm-slim AS runner
ENV NODE_ENV=production
WORKDIR /app
COPY --from=builder --chown=node:node /app/agent/package.json ./agent/package.json
COPY --from=builder --chown=node:node /app/agent/node_modules ./agent/node_modules
COPY --from=builder --chown=node:node /app/agent/dist ./agent/dist
COPY --from=builder --chown=node:node /app/shared ./shared
RUN mkdir -p /app/agent/traces && chown -R node:node /app
USER node
WORKDIR /app/agent
CMD ["node", "dist/agent.js"]
