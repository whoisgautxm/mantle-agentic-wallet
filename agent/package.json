{
  "name": "mantle-agent",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "vitest run",
    "start": "tsx src/agent.ts",
    "start:prod": "node dist/agent.js",
    "keeper": "tsx src/keeper.ts",
