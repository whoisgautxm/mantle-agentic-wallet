    "eval:generate-heldout": "tsx src/heldOutMarketFixtures.ts",
    "eval:strategy-suite": "tsx src/strategyOptimizationEval.ts",
    "eval:strategy-gate": "tsx src/strategyOptimizationGate.ts",
    "fixture:approved-candidate": "tsx src/approvedCandidateExecutionFixture.ts"
