    "baseline": "tsx src/baseline.ts",
    "baseline:prod": "node dist/baseline.js",
    "demo": "tsx src/demoStart.ts",
    "demo:start": "tsx src/demoStart.ts",
    "demo:status": "tsx src/demoStatus.ts",
    "demo:stop": "tsx src/demoStop.ts",
    "quote:merchant-moe": "tsx src/merchantMoeQuoteSmoke.ts",
    "readiness:merchant-moe": "tsx src/merchantMoeForkReadiness.ts",
    "simulate:merchant-moe-fork": "tsx src/merchantMoeForkSimulation.ts",
    "simulate:merchant-moe-fixture": "tsx src/merchantMoeForkFixture.ts",
    "simulate:merchant-moe-anvil": "tsx src/merchantMoeAnvilFixture.ts",
    "simulate:merchant-moe-adversarial": "tsx src/merchantMoeAdversarialFixture.ts",
