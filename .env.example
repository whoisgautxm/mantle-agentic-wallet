# Copy to .env and fill in. .env is gitignored — never commit it.

# Mantle Sepolia testnet RPC (verify current URL at https://docs.mantle.xyz)
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
# Optional dashboard event-log RPC. Public Mantle supports wider log ranges; set
# LOG_CHUNK_SIZE lower if your provider enforces small eth_getLogs windows.
LOGS_RPC_URL=https://rpc.sepolia.mantle.xyz
LOG_CHUNK_SIZE=50000

# Deployer / owner key (testnet only — fund from the Mantle faucet)
DEPLOYER_PRIVATE_KEY=0x...

# The AI agent's own key (a separate "session key" address; fund with a little gas)
AGENT_PRIVATE_KEY=0x...

# Baseline (human DCA) agent key — a third testnet key; fund with a little gas
BASELINE_PRIVATE_KEY=0x...

# Owner/deployer key used by the price keeper for owner-only MockDEX.setPrice.
# For local demos this can match DEPLOYER_PRIVATE_KEY, but keep it explicit so
# the autonomous agent key never silently gains owner powers.
OWNER_PRIVATE_KEY=0x...

# AI reasoning provider. Use "openai" or "anthropic".
AI_PROVIDER=openai

# OpenAI provider settings
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.2

# Anthropic provider settings (only needed if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Agent loop tuning (read by agent/src/agent.ts; see Task 4.2).
# AGENT_INTERVAL_MS: ms between ticks. AGENT_CONTEXT: the situation prompt that drives decisions.
AGENT_INTERVAL_MS=120000
AGENT_CONTEXT="You are competing against a passive DCA baseline. Trade actively on dips and rips per your mean-reversion strategy; be decisive."
KEEPER_INTERVAL_MS=45000
BASELINE_INTERVAL_MS=60000

# Risk limits, in basis points. Defaults are conservative demo values.
RISK_MAX_DEX_ORACLE_DEVIATION_BPS=300
RISK_MAX_POSITION_BPS=7000
RISK_MAX_TRADE_VALUE_BPS=2500

# Local JSONL traces for replay, reports, and evals. Set TRACE_ENABLED=false to disable.
TRACE_ENABLED=true
TRACE_DIR=traces
TRACE_JSONL_PATH=
TRACE_EVAL_INPUT=
TRACE_EVAL_OUTPUT=
SCENARIO_EVAL_DIR=
SCENARIO_EVAL_OUTPUT=

# Oracle source for agent risk checks and dashboard status.
# Default "mockdex" keeps the Sepolia demo deterministic.
# Set ORACLE_PROVIDER=pyth to use read-only Pyth Hermes MNT/USD as the reference.
ORACLE_PROVIDER=mockdex
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
PYTH_MNT_USD_PRICE_ID=0x4e3037c822d852d79af3ac80e35eb420ee3b870dca49f9344a38ef4773fb0585
PYTH_MAX_AGE_SECONDS=120

# Optional ERC20 portfolio tracking for real protocol adapters.
# Format: SYMBOL:address:decimals[:riskTier[:pricePair]], comma-separated.
PORTFOLIO_TOKENS=
# Format: NAME:address[:riskTier], comma-separated. Example tracks Merchant Moe's LB Router.
PORTFOLIO_SPENDERS=MerchantMoeLBRouter:0x013e138EF6008ae5FDFDE29700e3f2Bc61d21E3a:known

# Optional Merchant Moe read-only quoting on Mantle mainnet.
# Official Merchant Moe docs list mainnet LB Router/Quoter addresses; no live execution is enabled.
MERCHANT_MOE_CHAIN_ID=5000
MERCHANT_MOE_RPC_URL=
MERCHANT_MOE_LB_QUOTER=0x501b8AFd35df20f531fF45F6f695793AC3316c85
MERCHANT_MOE_LB_ROUTER=0x013e138EF6008ae5FDFDE29700e3f2Bc61d21E3a
# Required only for `cd agent && npm run quote:merchant-moe`.
# Format: tokenIn,tokenOut[,intermediateToken...]. Amount is raw token units.
MERCHANT_MOE_ROUTE=
MERCHANT_MOE_AMOUNT_IN_WEI=
# Optional quote/reference deviation check for smoke tests.
# For MNT -> USD-like routes, token-in/token-out price can be compared to Pyth's inverted MNT/USD feed.
MERCHANT_MOE_TOKEN_IN_DECIMALS=18
MERCHANT_MOE_TOKEN_OUT_DECIMALS=18
MERCHANT_MOE_REFERENCE_SOURCE=none
MERCHANT_MOE_REFERENCE_PRICE_WEI=
MERCHANT_MOE_MAX_DEVIATION_BPS=300

# Optional Telegram alerts for AI decisions. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Block explorer API (optional, only needed if you add `forge verify-contract`)
MANTLE_EXPLORER_API_URL=https://explorer.sepolia.mantle.xyz/api
