# Copy to .env and fill in. .env is gitignored — never commit it.

# Mantle Sepolia testnet RPC (verify current URL at https://docs.mantle.xyz)
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz

# Deployer / owner key (testnet only — fund from the Mantle faucet)
DEPLOYER_PRIVATE_KEY=0x...

# The AI agent's own key (a separate "session key" address; fund with a little gas)
AGENT_PRIVATE_KEY=0x...

# Baseline (human DCA) agent key — a third testnet key; fund with a little gas
BASELINE_PRIVATE_KEY=0x...

# Owner/deployer key used by the price keeper for owner-only MockDEX.setPrice.
# For local demos this can match DEPLOYER_PRIVATE_KEY, but keep it explicit so
# the autonomous agent key never silently gains owner powers.
OWNER_PRIVATE_KEY=0x...

# AI reasoning provider. Use "openai" or "anthropic".
AI_PROVIDER=openai

# OpenAI provider settings
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.2

# Anthropic provider settings (only needed if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Agent loop tuning (read by agent/src/agent.ts; see Task 4.2).
# AGENT_INTERVAL_MS: ms between ticks. AGENT_CONTEXT: the situation prompt that drives decisions.
AGENT_INTERVAL_MS=120000
AGENT_CONTEXT="You are competing against a passive DCA baseline. Trade actively on dips and rips per your mean-reversion strategy; be decisive."
KEEPER_INTERVAL_MS=45000
BASELINE_INTERVAL_MS=60000

# Optional Telegram alerts for AI decisions. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Block explorer API (optional, only needed if you add `forge verify-contract`)
MANTLE_EXPLORER_API_URL=https://explorer.sepolia.mantle.xyz/api
