# Copy to .env and fill in. .env is gitignored — never commit it.

# Mantle Sepolia testnet RPC (verify current URL at https://docs.mantle.xyz)
MANTLE_RPC_URL=https://rpc.sepolia.mantle.xyz
# Optional dashboard event-log RPC. Public Mantle supports wider log ranges; set
# LOG_CHUNK_SIZE lower if your provider enforces small eth_getLogs windows.
LOGS_RPC_URL=https://rpc.sepolia.mantle.xyz
LOG_CHUNK_SIZE=50000

# Deployer / owner key (testnet only — fund from the Mantle faucet)
DEPLOYER_PRIVATE_KEY=0x...

# The AI agent's own key (a separate "session key" address; fund with a little gas)
AGENT_PRIVATE_KEY=0x...

# Baseline (human DCA) agent key — a third testnet key; fund with a little gas
BASELINE_PRIVATE_KEY=0x...

# Owner/deployer key used by the price keeper for owner-only MockDEX.setPrice.
# For local demos this can match DEPLOYER_PRIVATE_KEY, but keep it explicit so
# the autonomous agent key never silently gains owner powers.
OWNER_PRIVATE_KEY=0x...

# AI reasoning provider. Use "openai" or "anthropic".
AI_PROVIDER=openai

# OpenAI provider settings
OPENAI_API_KEY=sk-proj-...
OPENAI_MODEL=gpt-5.2
# Live synchronized candidate-assessment eval reliability.
# Cache lets repeated runs replay already-assessed candidate IDs without another OpenAI call.
OPENAI_CANDIDATE_ASSESSMENT_CACHE=1
OPENAI_CANDIDATE_ASSESSMENT_CACHE_PATH=traces/openai-candidate-assessment-cache.json
# gpt-5.2 projects can have low RPM; keep this conservative unless your project has higher limits.
OPENAI_CANDIDATE_ASSESSMENT_MIN_INTERVAL_MS=65000
OPENAI_CANDIDATE_ASSESSMENT_DEFER_RATE_LIMIT=1
# Optional budget for smoke tests; blank means no per-regime cap.
OPENAI_CANDIDATE_ASSESSMENT_MAX_PER_REGIME=
# Adversarial candidate-critic eval. This scores OpenAI's approve/veto judgment on labeled bad candidates.
OPENAI_CANDIDATE_CRITIC_MODEL=gpt-4o-mini
OPENAI_CANDIDATE_CRITIC_CACHE=1
OPENAI_CANDIDATE_CRITIC_CACHE_PATH=traces/openai-candidate-critic-cache.json
OPENAI_CANDIDATE_CRITIC_MAX_RETRIES=2
OPENAI_CANDIDATE_CRITIC_MIN_INTERVAL_MS=0

# Anthropic provider settings (only needed if AI_PROVIDER=anthropic)
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# Agent loop tuning (read by agent/src/agent.ts; see Task 4.2).
# AGENT_INTERVAL_MS: ms between ticks. Estimated costs are used by the model-side edge gate.
AGENT_INTERVAL_MS=120000
AGENT_ESTIMATED_EXECUTION_COST_BPS=60
# "model" keeps the legacy model-only proposal path. "ensemble" uses the deterministic
# regime router as a candidate generator and OpenAI as a constrained approve/veto critic.
AGENT_STRATEGY=ensemble
AGENT_STRATEGY_BASELINE_MNT=0.005
# Pre-model economic gate: reject uneconomic deterministic candidates before spending an AI call.
AGENT_PRE_MODEL_COST_GATE=1
AGENT_PRE_MODEL_GAS_ESTIMATE_UNITS=170000
# Post-model revalidation: refresh state, regenerate the deterministic candidate, requote, and simulate
# before submit. Blocks if action/regime changes or drift exceeds these tolerances.
AGENT_POST_MODEL_REVALIDATION=1
AGENT_REVALIDATION_MAX_PRICE_DRIFT_BPS=150
AGENT_REVALIDATION_MAX_AMOUNT_DRIFT_BPS=250
AGENT_PRICE_FRESHNESS_BPS=100
# Recovery-state probe (off by default; no measured held-out improvement — see recovery-and-heldout report).
ENSEMBLE_RECOVERY_PROBE=0
AGENT_CONTEXT="Classify the observed regime before acting. Preserve capital in confirmed downtrends, avoid premature selling in sustained rallies, and trade only when expected edge exceeds costs."
# P1 live-execution gates (default off; enable for a controlled run — live-run report sections 6, 10).
# Dynamic cost gate: block a trade whose expected edge can't clear observed gas + fees + slippage.
AGENT_DYNAMIC_COST_GATE=0
AGENT_FEE_BPS=0
EXECUTION_SLIPPAGE_BPS=100
AGENT_COST_BUFFER_BPS=10
# Quote-to-submit freshness: skip submission if the pinned observation block is >N blocks behind head
# (0 disables). Prevents OracleFloorTooLow reverts from a moved oracle floor between quote and inclusion.
AGENT_MAX_BLOCK_DRIFT=0
KEEPER_INTERVAL_MS=45000
# Keeper price mode: "walk" (default, non-reproducible Math.random) | "scripted" (fixed 40-tick regime
# sequence: warm-up->downtrend->recovery->rally->range) | "seeded" (deterministic walk from KEEPER_SEED).
# Use scripted/seeded for controlled benchmarks where AI and DCA must face the SAME market across runs.
KEEPER_PRICE_MODE=walk
KEEPER_SEED=20260607
KEEPER_START_TICK=0
KEEPER_MAX_STEP_BPS=600
BASELINE_INTERVAL_MS=60000

# One-command local demo orchestrator.
DEMO_DASHBOARD_PORT=3000
DEMO_RUN_SCENARIO_EVAL=true
DEMO_RUN_TRACE_EVAL_ON_STOP=true

# Risk limits, in basis points. Defaults are conservative demo values.
RISK_MAX_DEX_ORACLE_DEVIATION_BPS=300
RISK_MAX_POSITION_BPS=7000
RISK_MAX_TRADE_VALUE_BPS=2500

# Local JSONL traces for replay, reports, and evals. Set TRACE_ENABLED=false to disable.
TRACE_ENABLED=true
TRACE_DIR=traces
TRACE_JSONL_PATH=
TRACE_EVAL_INPUT=
TRACE_EVAL_OUTPUT=
SCENARIO_EVAL_DIR=
SCENARIO_EVAL_OUTPUT=

# Oracle source for agent risk checks and dashboard status.
# Default "mockdex" keeps the Sepolia demo deterministic.
# Set ORACLE_PROVIDER=pyth to use read-only Pyth Hermes MNT/USD as the reference.
ORACLE_PROVIDER=mockdex
PYTH_HERMES_URL=https://hermes.pyth.network
PYTH_API_KEY=
PYTH_MNT_USD_PRICE_ID=0x4e3037c822d852d79af3ac80e35eb420ee3b870dca49f9344a38ef4773fb0585
PYTH_MAX_AGE_SECONDS=120

# Optional ERC20 portfolio tracking for real protocol adapters.
# Format: SYMBOL:address:decimals[:riskTier[:pricePair]], comma-separated.
PORTFOLIO_TOKENS=
# Format: NAME:address[:riskTier], comma-separated. Example tracks Merchant Moe's LB Router.
PORTFOLIO_SPENDERS=MerchantMoeLBRouter:0x013e138EF6008ae5FDFDE29700e3f2Bc61d21E3a:known

# Optional Merchant Moe read-only quoting on Mantle mainnet.
# Official Merchant Moe docs list mainnet LB Router/Quoter addresses; no live execution is enabled.
MERCHANT_MOE_CHAIN_ID=5000
MERCHANT_MOE_RPC_URL=
MERCHANT_MOE_LB_QUOTER=0x501b8AFd35df20f531fF45F6f695793AC3316c85
MERCHANT_MOE_LB_ROUTER=0x013e138EF6008ae5FDFDE29700e3f2Bc61d21E3a
# Required only for `cd agent && npm run quote:merchant-moe`.
# Preferred route presets: wmnt-usdc-direct, wmnt-moe-usdc, wmnt-usdt-direct, wmnt-usde-direct.
# Format for manual route: tokenIn,tokenOut[,intermediateToken...]. Amount is raw token units.
MERCHANT_MOE_ROUTE_PRESET=wmnt-usdc-direct
MERCHANT_MOE_ROUTE=
MERCHANT_MOE_AMOUNT_IN_WEI=
# Readiness/fork-simulation protection metadata. Execution remains disabled.
MERCHANT_MOE_SLIPPAGE_BPS=100
MERCHANT_MOE_DEADLINE_SECONDS=1200
MERCHANT_MOE_FORK_RPC_URL=
MANTLE_MAINNET_FORK_RPC_URL=
MERCHANT_MOE_ENABLE_FORK_SIMULATION=false
MERCHANT_MOE_SIMULATION_MODE=router-call
MERCHANT_MOE_SIMULATION_FROM=
MERCHANT_MOE_SIMULATION_VAULT=
MERCHANT_MOE_SIMULATION_VALUE_WEI=0
MERCHANT_MOE_SWAP_CALLDATA=
MERCHANT_MOE_SIMULATION_RATIONALE=Merchant Moe mainnet-fork simulation
# Optional quote/reference deviation check for smoke tests.
# For MNT -> USD-like routes, token-in/token-out price can be compared to Pyth's inverted MNT/USD feed.
MERCHANT_MOE_TOKEN_IN_DECIMALS=
MERCHANT_MOE_TOKEN_OUT_DECIMALS=
MERCHANT_MOE_REFERENCE_SOURCE=
MERCHANT_MOE_REFERENCE_PRICE_WEI=
MERCHANT_MOE_MAX_DEVIATION_BPS=

# Optional read-only lending/yield risk readiness. These JSON inputs are local snapshots only.
LENDING_PROTOCOL_ID=lendle
LENDING_ACCOUNT=
LENDING_POSITION_JSON=
LENDING_MARKETS_JSON=
LENDING_MIN_HEALTH_FACTOR_BPS=15000
LENDING_WARN_HEALTH_FACTOR_BPS=18000
LENDING_MAX_MARKET_UTILIZATION_BPS=9000
LENDING_MAX_CAP_USAGE_BPS=9500

# Optional Telegram alerts for AI decisions. Leave blank to disable.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Block explorer API (optional, only needed if you add `forge verify-contract`)
MANTLE_EXPLORER_API_URL=https://explorer.sepolia.mantle.xyz/api
